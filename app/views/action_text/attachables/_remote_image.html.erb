<figure class="attachment attachment--preview">
  <% filename = remote_image.node['filename'].presence || 'file' %>
  <% inline_url = remote_image.url %>
  <% download_url = remote_image.node['href'].presence || inline_url %>
  <% size_text = remote_image.node['filesize'].to_i.positive? ? number_to_human_size(remote_image.node['filesize']) : nil %>
  <%= build_image_attachment_html(
        preview_src: inline_url,
        inline_url: inline_url,
        download_url: download_url,
        filename: filename,
        size_text: size_text
      ).html_safe %>
</figure>