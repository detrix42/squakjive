
<%# Renders ActionText::RichText using our custom attachment normalizer/cleanup when available.
     This ensures mangled inlined content (the '<' + 🎥 + filename (size) + 'div>' leaks the user is seeing
     even on fresh posts) gets cleaned, and video/PDF attachments use the flat structure.
%>
<% if defined?(render_rich_text_with_attachments) %>
  <%= render_rich_text_with_attachments(rich_text) %>
<% else %>
  <%# Fallback to the original default behavior %>
  <% content_html =
       if defined?(rich_text) && rich_text.respond_to?(:body) && rich_text.body.respond_to?(:to_html)
         rich_text.body.to_html.presence
       end %>
  <%= content_html ? raw(content_html) : rich_text.to_s %>
<% end %>

