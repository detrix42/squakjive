<!-- app/views/action_text/attachments/_plain.html.erb -->
<%# Renders plain text files as a link %>
<% attachable = attachment.attachable %>
<figure class="attachment attachment--file">
  <a href="<%= rails_blob_path(attachable, disposition: :inline) %>"
     data-turbo="false"
     rel="noopener">
    <%= attachable.respond_to?(:filename) ? attachable.filename.to_s : (attachment.caption.presence || "file") %>
    <% if attachable.respond_to?(:byte_size) %>
      (<%= number_to_human_size(attachable.byte_size) %><%= attachable.content_type.present? ? ", #{attachable.content_type}" : "" %>)
    <% end %>
  </a>
</figure>
