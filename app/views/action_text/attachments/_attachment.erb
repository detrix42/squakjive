<% if attachment.representable? %>
  <%= link_to rails_blob_path(attachment, disposition: "inline"), class: "attachment__link", target: "_blank", rel: "noopener" do %>
    <%= image_tag attachment, class: "attachment attachment--preview attachment--#{attachment.blob.filename.extension}" %>
  <% end %>
<% else %>
  <%= link_to rails_blob_path(attachment, disposition: "attachment"), class: "attachment__link", target: "_blank", rel: "noopener" do %>
    <figure class="attachment attachment--file attachment--<%= attachment.blob.filename.extension %>">
      <figcaption class="attachment__caption">
        <% if caption = attachment.blob.try(:caption) %>
          <%= caption %>
        <% else %>
          <span class="attachment__name"><%= attachment.blob.filename %></span>
          <span class="attachment__size"><%= number_to_human_size(attachment.blob.byte_size) %></span>
        <% end %>
      </figcaption>
    </figure>
  <% end %>
<% end %>
