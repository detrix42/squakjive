<%# app/views/action_text/attachments/_attachment.html.erb %>
<%# Renders ActionText attachments with sane defaults:
    - Images: inline preview wrapped in a link (Turbo disabled).
    - Other files: clickable link (Turbo disabled, download suggested).
%>

<%# ActionText provides `attachment` (ActionText::Attachment) here %>
<% attachable = attachment.attachable %>

<% if attachment.previewable? %>
  <figure class="attachment attachment--preview attachment--image">
    <a href="<%= url_for(attachment) %>" data-turbo="false" target="_blank" rel="noopener">
      <%# Prefer the previewable variant generated by ActionText %>
      <%= image_tag attachment.previewable_variant %>
    </a>
    <figcaption class="attachment__caption">
      <%= (attachable.respond_to?(:filename) ? attachable.filename.to_s : attachment.caption).presence || "image" %>
    </figcaption>
  </figure>

<% else %>
  <figure class="attachment attachment--file">
    <a href="<%= url_for(attachment) %>"
       data-turbo="false"
       download="<%= attachable.respond_to?(:filename) ? attachable.filename.to_s : 'download' %>"
       rel="noopener">
      <%= attachable.respond_to?(:filename) ? attachable.filename.to_s : (attachment.caption.presence || "file") %>
      <% if attachable.respond_to?(:byte_size) %>
        (<%= number_to_human_size(attachable.byte_size) %><%= attachable.content_type.present? ? ", #{attachable.content_type}" : "" %>)
      <% end %>
    </a>
  </figure>
<% end %>
