<% if blob.representable? %>
  <%= link_to rails_blob_path(blob, disposition: "inline"), class: "attachment__link", target: "_blank", rel: "noopener" do %>
    <%= image_tag blob, class: "attachment attachment--preview attachment--#{blob.filename.extension}" %>
  <% end %>
<% else %>
  <%= link_to rails_blob_path(blob, disposition: "attachment"), class: "attachment__link", target: "_blank", rel: "noopener" do %>
    <figure class="attachment attachment--file attachment--<%= blob.filename.extension %>">
      <figcaption class="attachment__caption">
        <% if caption = blob.try(:caption) %>
          <%= caption %>
        <% else %>
          <span class="attachment__name"><%= blob.filename %></span>
          <span class="attachment__size"><%= number_to_human_size blob.byte_size %></span>
        <% end %>
      </figcaption>
    </figure>
  <% end %>
<% end %>
