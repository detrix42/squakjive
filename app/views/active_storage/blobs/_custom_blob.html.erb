<%#
  Custom partial used for ActiveStorage::Blob attachments inside ActionText rich content (via to_attachable_partial_path).
  Special handling for PDFs (and other previewables) so that a pre-generated thumbnail
  stored in blob.metadata['preview_url'] (from the composer) is used if available.
  This ensures the thumbnail survives the submit/render cycle for squaks.
%>
<figure class="attachment attachment--<%= blob.representable? ? 'preview' : 'file' %> attachment--<%= blob.filename.extension %>">
  <% if blob.content_type&.start_with?('application/pdf') %>
    <a href="<%= rails_blob_url(blob, disposition: "attachment") %>" target="_blank" rel="noopener">
      <% preview_url = blob.metadata.with_indifferent_access['preview_url'].presence %>
      <% if preview_url.present? %>
        <%= image_tag preview_url, alt: blob.filename.to_s, class: "attachment-preview-img" %>
      <% elsif blob.previewable? %>
        <%# Fallback: generate on the fly if previewer is available %>
        <%= image_tag blob.preview(resize_to_limit: [500, 600]).processed, alt: blob.filename.to_s, class: "attachment-preview-img" %>
      <% else %>
        <%= blob.filename %>
      <% end %>
    </a>
    <br>
    <a href="<%= rails_blob_url(blob, disposition: "attachment") %>" target="_blank" rel="noopener" class="attachment-caption-link">
      📄 <%= blob.filename %> (<%= number_to_human_size(blob.byte_size) %>)
    </a>
  <% elsif blob.content_type&.start_with?('video/') %>
    <% preview_url = blob.metadata.with_indifferent_access['preview_url'].presence %>
    <% video_src = rails_blob_url(blob, disposition: "inline") %>
    <% poster = preview_url.presence || (blob.preview(resize_to_limit: [500, 600]).processed rescue nil) %>
    <video controls preload="metadata"<%= " poster=\"#{poster}\"" if poster %> class="attachment-video-player">
      <source src="<%= video_src %>">
    </video>
    <br>
    <a href="<%= rails_blob_url(blob, disposition: "attachment") %>" target="_blank" rel="noopener" class="attachment-caption-link">
      🎥 <%= blob.filename %> (<%= number_to_human_size(blob.byte_size) %>)
    </a>
  <% elsif blob.representable? %>
    <% if blob.image? %>
      <%= link_to rails_blob_url(blob, disposition: "attachment"), title: "Download #{blob.filename}" do %>
        <%= image_tag blob.variant(resize_to_limit: [800, 600]).processed, alt: "Preview of #{blob.filename}", class: "attachment-preview-img" %>
      <% end %>
    <% elsif blob.previewable? %>
      <%= link_to rails_blob_url(blob, disposition: "attachment"), title: "Download #{blob.filename}" do %>
        <%= image_tag blob.preview(resize_to_limit: [800, 600]).processed, alt: "Preview of #{blob.filename}", class: "attachment-preview-img" %>
      <% end %>
    <% else %>
      <%= link_to blob.filename, rails_blob_url(blob, disposition: "attachment") %>
    <% end %>
  <% else %>
    <%= link_to blob.filename, rails_blob_url(blob, disposition: "attachment") %>
  <% end %>
  <% unless blob.content_type&.start_with?('application/pdf') || blob.content_type&.start_with?('video/') %>
  <figcaption class="attachment__caption">
    <span class="attachment__size">(<%= number_to_human_size(blob.byte_size) %>)</span>
  </figcaption>
  <% end %>
</figure>
