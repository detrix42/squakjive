<li id="circle-id-<%= circle.id %>"
    class="circle-item <%= 'selected' if @selected_circle_id.to_i == circle.id %>"
    data-circles-target="item"  <%# Fixed from data-circles-circle-selection-target %>
    data-action="click->circles#select"
    data-circles-circle-id="<%= circle.id %>"
    data-circles-circle-name="<%= circle.name %>">
  <div class="row">
    <div class="col-9">
      <div class="d-flex">
        <div class="d-inline-block circle-name-<%= circle.id %>">
          <% if @selected_circle_id == circle.id %>
            <strong><%= circle.name %></strong>
          <% else %>
            <%= circle.name %>
          <% end %>
        </div>
        <div id="circle-members-count-<%= circle.id %>">
          (<%= circle.members_count %>)
        </div>
      </div>
    </div>
    <div class="col-3">
      <div class="row circle-action-panel">
        <% unless circle.id == 0 %>
          <div class="ms-auto circle-add-user-icon"
               id="add-user-icon-<%= circle.id %>"
               data-action="click->circles#add_user">
            <i class="icon bi bi-person-plus ms-auto"></i>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <ul class="circle-user-list" id="circle-user-list-<%= circle.id %>"
      data-circles-target="user-list">  <%# Moved to <ul>, added target %>
    <%= render partial: 'circles/user_item',
               collection: circle.visible_members(current_user), as: :user,
               locals: { circle: circle } %>
  </ul>
</li>
