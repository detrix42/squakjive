<li class="circle-item" id="circle-id-<%= circle.id %>"
    data-circles-circle-selection-target="item"
    data-action="click->circles#select"
    data-circles-circle-id="<%= circle.id %>"
    data-circles-circle-name="<%= circle.name %>">
  <div class="row">
    <div class="col-9">
      <div class="d-flex">
        <div class="d-inline-block circle-name-<%= circle.id %>">
          <% if @selected_circle_id == circle.id %>
            <strong><%= circle.name %></strong>
          <% else %>
            <%= circle.name %>
          <% end %>
        </div>
        <div class="circle-members-count-<%= circle.id %>">
          (<%= circle.members_count %>)
        </div>
      </div>

    </div>
    <div class="col-3">
        <div class="row circle-action-panel">
          <div class="circle-add-user-icon"
               id="add-user-icon-<%= circle.id %>"
               data-action="click->circles#add_user">
            <i class="icon bi bi-person-plus ms-auto" ></i>
          </div>
        </div>

    </div>
  </div>
  <div class="col circle-user-list" id="circle-user-list-<%= circle.id %>">
    <%= render partial: 'circles/user_item',
               collection: circle.members, as: :user,
               locals: { circle: circle } %>
  </div>
</li>
