<li id="circle-id-<%= circle.id %>"
    class="circle-item <%= 'selected' if @selected_circle_id.to_i == circle.id %> <%= 'owner' if circle_owner(circle) == current_user.username %>"
    data-circles-target="item"  <%# Fixed from data-circles-circle-selection-target %>
    data-action="click->circles#select"
    data-circles-circle-id="<%= circle.id %>"
    data-circles-circle-name="<%= circle.name %>">
  <div class="row">
    <div class="col-8">
      <div class="d-flex justify-content-start">
        <div id="circle-members-count-<%= circle.id %>"
             class="member-count-badge">
          <%= member_count(circle) %>
        </div>
        <div class="d-inline-block circle-name-<%= circle.id %>">
          <% if @selected_circle_id == circle.id %>
            <strong><%= circle.name %></strong>
          <% else %>
            <%= circle.name %>
          <% end %>
        </div>

      </div>
    </div>
    <div class="col-4">
      <div class="d-flex justify-content-end circle-action-panel">
        <% unless circle.id == 0 %>
          <div class=" circle-add-user-icon"
               id="add-user-icon-<%= circle.id %>"
               data-action="click->circles#add_user">
            <i class="icon bi bi-person-plus ms-auto"></i>
          </div>
        <% end %>



        <% if circle_owner(circle) == current_user.username %>
          <div class="circle-remove-icon"
               id="remove-circle-icon-<%= circle.id %>"
               data-circles-circle-id="<%= circle.id %>"
               data-circles-circle-name-value="<%= circle.name %>"
               data-action="click->circles#remove_circle">
            <i class="icon bi bi-trash ms-auto"></i>
          </div>
        <% end %>

      </div>
    </div>
  </div>
  <ul class="circle-user-list" id="circle-user-list-<%= circle.id %>"
      data-circles-target="user-list">  <%# Moved to <ul>, added target %>
    <%= render partial: 'circles/user_item',
               collection: circle.visible_members(current_user), as: :user,
               locals: { circle: circle } %>
    <% unless circle_owner?(circle, current_user) %>
      <li class="d-flex justify-content-end footer-row mt-2"    >

        <div class="circle-rem-self-icon"
             id="remove-self-icon-<%= circle.id %>"
             data-circles-circle-id="<%= circle.id %>"
             data-circles-circle-name-value="<%= circle.name %>"
             data-controller="tooltips circle-membership"
             data-tooltips-content-value="Click to remove yourself from this circle"
             data-tooltips-placement-value="left"
             data-action="click->circle-membership#remove_self_from_circle mouseenter->tooltips#show mouseleave->tooltips#hide">
          <i class="icon bi bi-person-dash ms-auto"></i>
        </div>
      </li>
    <% end %>

  </ul>



</li>
