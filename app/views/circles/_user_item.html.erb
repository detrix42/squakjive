<div class="user-item d-flex align-items-center py-1 px-2 mb-1 rounded bg-light border user-list-entry"
     id="sidebar-user-item-<%= user.id %>">
<!--  <i class="bi bi-person-circle me-2 text-secondary" style="font-size:1.2rem;"></i>-->
  <%= image_tag "https://robohash.org/#{user.username}?size=30x30", class: "img-fluid" %>
  <span class="fw-semibold text-dark flex-grow-1"><%= user.username %></span>
  <% if circle_owner?(circle, user) %>
    <span class="owner-icon"><i class="bi bi-star"></i></span>
  <% end %>
  <% unless circle.id == 0 %>
    <% if owner_and_member?(user, circle) %>

      <button class="btn btn-sm btn-link text-danger ms-2"
              data-controller="circle-membership"
              data-circle-membership-user-id-value="<%= user.id %>"
              data-circle-membership-circle-id-value="<%= circle.id %>"
              data-action="click->circle-membership#remove_member">
        <i class="bi bi-x-circle"></i>
      </button>
    <% end %>
  <% end %>

</div>
