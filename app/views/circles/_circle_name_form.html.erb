<div class="modal fade" id="newCircleModal"
     tabindex="-1" aria-labelledby="newCircleModalLabel"
     aria-hidden="true"
     data-controller="circle-name-modal">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="newCircleModalLabel">Create New Circle</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= form_with(model: @circle, data: { turbo_frame: "new-circle-modal" }) do |f| %>
        <div class="modal-body">
          <div class="mb-3">
            <%= f.label :name, class: "form-label" %>
            <%= f.text_field :name, class: "form-control",
                 autofocus: true,
                 data: { circle_name_modal_target: "input" } %>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <%= f.submit "Create Circle", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
