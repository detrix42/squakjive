<div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh;">

  <div class="card p-4" style="max-width: 580px; width: 100%;">
    <h2>Log in</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field">
        <%= f.label :username, class: "form-label" %>
        <%= f.text_field :username, autofocus: true, class: "form-control", autocomplete: "username" %>
      </div>

      <div class="field">
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, class: "form-control", autocomplete: "current-password" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="field">
          <%= f.check_box :remember_me, class: "form-control" %>
          <%= f.label :remember_me, class: "form-label" %>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit "Log in", class: "btn btn-primary" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>

