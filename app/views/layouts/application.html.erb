<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "SquakJive" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png" data-squakjive-brand-icon="true">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "trix", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body style="">

  <div class="container flash-msg" style="max-width: 580px">
    <div id="flash">
      <%= render "shared/flashes" if flash.any? %>
    </div>
  </div>

    <%= yield %>

  <%=  turbo_frame_tag "new-circle-modal" %>
  <%=  turbo_frame_tag "circle-add-user-modal" %>

  <script>
    document.addEventListener("turbo:load", function() {
      document.body.style.visibility = "visible";
    })
  </script>
  </body>
</html>
