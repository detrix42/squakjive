<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Image viewer" %> · SquakJive</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="<%= brand_icon_path(size: '32x32') %>" type="image/png" data-squakjive-brand-icon="true">
    <%= stylesheet_link_tag "image_viewer", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="image-viewer-body">
    <%= yield %>
  </body>
</html>