<!-- app/views/dashboard/_squak_form.html.erb -->
<%= form_with model: Squak.new,
              id: "squak-form",
              url: squaks_path,
              data: {
                turbo: true,
                controller: "squakeditor",
                direct_upload_url: "/rails/active_storage/direct_uploads"
              } do |f| %>
  <%= f.hidden_field :circle_id,
                     id: "squak-circle-id",
                     value: (defined?(circle_id) ? circle_id : params[:circle_id]) %>
  <div class="mb-3" id="squak-editor">
    <%= f.rich_text_area :body, class: "form-control",
        data: { controller: "attachments paste-image paste-url"  }
    %>
  </div>
  <div class="ms-auto me-3">
    <%= f.submit "Squak It", class: "btn btn-primary" %>
  </div>
<% end %>

