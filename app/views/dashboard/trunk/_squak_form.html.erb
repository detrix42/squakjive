<div class="d-flex w-100 ms-3">
  <div>Squak to: </div>
  <div class="mx-2 flex-shrink-1"
       id="editor-circle-name"
       data-controller="circles"
       data-circles-circle-role-value="squak_to_display"
       data-circles-circle-name-value="<%= @selected_circle_name %>" >
    active circle
  </div>
</div>
<%= form_with model: Squak.new, id: "squak-form",
              data: {
                action: "submit->paste-image#beforeSubmit turbo:submit-end->squakeditor#onTurboSubmitEnd",
                controller: "squakeditor paste-image",
              } do |f| %>

  <trix-toolbar id="squak-toolbar" data-controller="squakeditor"></trix-toolbar>

  <%# Wrapper runs both controllers so paste-image can access its targets %>
  <%# and squakeditor can access its targets %>
  <trix-editor
    data-controller="squakeditor"
    toolbar="squak-toolbar"
    input="squak-body"
  >
  </trix-editor>


  <%# Hidden textarea (Rails will submit this as squak[body]) %>
  <%= f.text_area :body, id: "squak-body",
                  style: "display: none;",
                  data: { 'squakeditor_target': "html" } %>

  <div class="row align-items-start"
       data-squakeditor-circle-id-value="<%= circle_id %>"
       data-controller="squakeditor paste-image">
    <%# Hidden direct-upload-capable input: gives us the directUploadUrl  %>
    <%= f.file_field :images,
                     multiple: true,
                     direct_upload: true,
                     class: "d-none",
                     data: { paste_image_target: "uploader" } %>

    <%# Hidden signed_ids will be appended here  %>
    <div data-paste-image-target="signedIds"></div>

    <%# Simple Previews %>
    <div class="d-flex flex-wrap mt-2" data-paste-image-target="previews"></div>

    <%= f.hidden_field :circle_id, value: circle_id, data: { squakeditor_target: "circleId" } %>

    <div class="d-flex justify-content-between ms-2 mt-1">
      <div class="d-flex flex-column flex-shrink-1">
        <div>Squak to: </div>
        <div class="mx-2 flex-shrink-1"
             id="editor-circle-name"
             data-controller="circles"
             data-circles-circle-role-value="squak_to_display"
             data-circles-circle-name-value="<%= @selected_circle_name %>" >
          active circle
        </div>
      </div>

      <div class=" me-3">
        <%= f.submit "Squak It", class: "btn btn-primary" %>
      </div>
    </div>
    <%# URL previews will appear here (client-only for now) %>
    <div class="mt-2" data-squakeditor-target="previews"></div>

  </div>

<% end %>
