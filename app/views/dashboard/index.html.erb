<div class="container-fluid center-text">
  <div class="row">
    <div class="d-flex flex-column col-3"
         id="circles-column-sidebar"
         style="background-color: #383d3e;">

        <%= render "brand_logo" %>
        <%= render partial: "circles/circle_sidebar" %>

    </div>

    <div class="col-6">
      <%= render 'squak_form' %>
      <%= turbo_frame_tag "squak-view" do %>
        <%= render partial: 'squak_index', locals: { squaks: @squaks } %>
      <% end %>
    </div>
    <div class="col-3" style="background-color: #343934; height: 100vh;">
      <%= render partial: "user_info_card" %>
    </div>
  </div>
</div>
