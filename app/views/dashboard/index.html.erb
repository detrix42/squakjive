<div class="container-fluid center-text" style="min-height: 100vh;">
  <div class="row">
    <div class="d-flex flex-column col-3"
         id="circles-column-sidebar"
         style="background-color: #383d3e;">

        <%= render "brand_logo" %>
        <%= render partial: "circles/circle_sidebar" %>

    </div>

    <div class="col-6">
      <%= render partial: 'squak_form', locals: { circle_id: @selected_circle_id} %>
      <%= turbo_frame_tag "squak-view" do %>
        <%= render partial: 'squaks/squak_index', locals: { squaks: @squaks,
                                                            circleId: @selected_circle&.id || 0 } %>
      <% end %>

    </div>
    <div id="right-column-sidebar" class="col-3" style="background-color: #343934;">
      <%= render partial: "user_info_card" %>

      <%= turbo_frame_tag "invite-to-circle-frame" do %>
        <%= turbo_stream_from [current_user, :user_invites] %>

        <div id="user-invites-list">
          <% if @invites.present? %>
            <%= render partial: "dashboard/user_invites", collection: @invites, as: :invite %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
