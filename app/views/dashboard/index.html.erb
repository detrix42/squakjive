<%= current_user.email %> signed in.
<%= link_to "Log out", destroy_user_session_path, data: { "turbo_method": :delete}, class: "btn btn-primary btn-lg" %>

<%= form_with model: Squak.new do |form| %>
  <%= form.text_field :body %>
  <%= form.submit "Squak It" %>
<% end %>

<ul>
  <% Squak.find_each do |squak| %>
    <li><%= squak.body %></li>
  <% end %>
</ul>
