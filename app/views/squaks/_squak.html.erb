<!-- app/views/squaks/_squak.html.erb -->

<li class="squak-item  m-3 px-1 py-1">
  <div class="row">
    <div class="col-sm-3 col-md-2 col-lg-1 squak-avatar-col">
      <div class="squak-avatar">
        <%= image_tag "https://robohash.org/#{squak.user.username}?size=60x60", class: "img-fluid" %>
      </div>
    </div>
    <div class="col-sm-9 col-md-10 col-lg-11">
      <div class="ms-1 squak-username">
        <%= squak.user.username %>
      </div>
      <div class="ms-4 squak-body">
        <%= render_squak_body(squak) %>
      </div>

      <%# Preview goes here (bottom of squak) %>
      <% urls = all_urls_from_html(squak.body) %>
      <% if urls.present? %>
        <div class="ms-4 mt-2 squak-previews-scroll">
          <% urls.each do |u| %>
            <% if (preview = link_preview_for(u)) %>
              <%= render partial: "squaks/link_preview", locals: { preview: preview, url: u } %>
            <% end %>
          <% end %>
        </div>
      <% end %>


      <div class="">
        <div class="squak-date text-end" style="color: #587a91;">
          <%= squak.created_at.strftime("%m-%d-%Y %l:%M %P") %>
        </div>
      </div>
    </div>
  </div>
</li>
