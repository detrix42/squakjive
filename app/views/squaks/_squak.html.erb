<%# app/views/squaks/_squak.html.erb %>

<li class="squak-item  m-3 px-1 py-1"
    id="squak-<%= squak.id %>"
    data-squak-id="<%= squak.id %>">
  <div class="row">

    <div class="col-sm-3 col-md-2 col-lg-1 squak-avatar-col">
      <div class="squak-avatar">
        <%= image_tag robohash_avatar_url(squak.user.username, size: "60x60"), class: "img-fluid", alt: squak.user.username %>
      </div>
    </div>

    <%# feed column  %>
    <div class="col-sm-9 col-md-10 col-lg-11">
      <div class="d-flex align-items-start justify-content-between">
        <div class="ms-1 squak-username">
          <%= squak.user.username %>
        </div>

        <% if can_destroy_squak?(user, squak) %>
          <%= link_to squak_path(squak),
                      data: { turbo_method: :delete, turbo_confirm: "Delete this squak?" },
                      class: "text-danger text-decoration-none",
                      title: "Delete squak" do %>
            <i class="bi bi-trash"></i>
          <% end %>
        <% end %>
      </div>

      <div class="ms-4 squak-body">
        <%= render_rich_text_with_attachments(squak.body) %>
      </div>

      <div class="squak-footer">
        <div class="squak-date text-end">
          <time data-controller="local-time"
                data-local-time-format-value="MM-dd-yyyy h:mm a"
                datetime="<%= squak.created_at.iso8601 %>">
            <%= squak.created_at.strftime("%m-%d-%Y %l:%M %P") %>
          </time>
        </div>
      </div>
    </div>
  </div>
</li>
