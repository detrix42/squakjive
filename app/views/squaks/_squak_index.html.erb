<%# app/views/squaks/_squak_index.html.erb  %>
<%= turbo_stream_from "squaks" %>

<% per_page = 10 %>
<% if squaks.present? %>
  <%# Attach controller to a wrapper so both list and button are inside its scope %>
  <div id="squaks-wrapper"
       data-controller="squakindex"
       data-squakindex-circle-id-value="<%= circleId %>"
       data-squakindex-limit-value="<%= per_page %>">

    <ul class="squaks-list" id="squaks-list">
      <% if squaks.present?  %>
        <%= render partial: "squaks/squak", collection: squaks, as: :squak, locals: {user: current_user} %>

        <li id="squaks-sentinel"
            data-squakindex-target="sentinel"
            class="py-2 text-center text-muted list-unstyled">
          Loading more…
        </li>
      <% end %>
    </ul>

    <button type="button"
            class="btn btn-secondary back-to-top d-none"
            title="Back to top"
            data-squakindex-target="backToTop"
            data-action="click->squakindex#scrollTop">
      ↑ Top
    </button>
  </div>

<% else %>
  <ul class="squaks-list" id="squaks-list"
      data-controller="squakindex"
      data-squakindex-circle-id-value="<%= circleId %>"
      data-squakindex-limit-value="<%= per_page %>">
  </ul>


  <p>No squaks in this circle yet.</p>
<% end %>

<script>
  document.addEventListener("turbo:connect", () => {
    console.log("Turbo connected!");
  });
  document.addEventListener("turbo:cable-ready", () => {
    console.log("ActionCable subscription active!");
  });
</script>
