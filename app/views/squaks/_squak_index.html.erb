<%# app/views/squaks/_squak_index.html.erb  %>
<% if squaks.present? %>

  <ul class="squaks-list" id="squaks-list"
      data-squakindex-circle-id-value="<%= circleId %>"
      data-controller="squakindex">

      <%= render partial: "squaks/squak", collection: squaks, as: :squak %>

  </ul>
<% else %>
  <p>No squaks in this circle yet.</p>
<% end %>
